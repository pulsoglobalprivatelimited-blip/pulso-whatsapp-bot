+async function whatsappPhoneForLoginPhone(phone) {
+  const login = normalizePhoneNumber(phone);
+  if (!login) return '';
+  const snap = await db.collection('botOnboardingLoginPhones').doc(login).get();
+  const target = snap.exists ? normalizePhoneNumber((snap.data() || {}).whatsappPhone || '') : '';
+  return target && target !== login ? target : '';
